# .env
HOST_IP=мой ip

TRAIN_TOPIC=insurance_train
VALIDATE_TOPIC=insurance_validate
GROUP_ID=insurance_consumer_group

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=insurance_db
MYSQL_USER=insurance_user
MYSQL_PASSWORD=insurance_pass
MYSQL_ROOT_PASSWORD=rootpassword

STAGING_MODELS_PATH=/app/ml/checkpoints/staging/models
ACTIVE_MODELS_PATH=/app/ml/checkpoints/active/models
BACKUP_MODELS_PATH=/app/ml/checkpoints/backup/models
STAGING_FILTERS_PATH=/app/ml/checkpoints/staging/filters
ACTIVE_FILTERS_PATH=/app/ml/checkpoints/active/filters
BACKUP_FILTERS_PATH=/app/ml/checkpoints/backup/filters
PREDICTOR_STATE_FILENAME=predictor_state.json
FLAG_FILENAME=NEW_MODEL.flag

INITIAL_TRAINING_SAMPLES=100000
MIN_TRAINING_SAMPLES=10000
MIN_VALIDATION_SAMPLES=5000
BATCH_SIZE=1000
